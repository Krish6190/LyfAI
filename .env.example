# At least two keys, comma-separated. Never commit real keys.
LLM_API_KEYS=key-one-placeholder,key-two-placeholder
# LiteLLM's Groq prefix plus the provider model id.
LLM_MODEL=groq/openai/gpt-oss-20b
# Set this for providers that expose an OpenAI-compatible endpoint.
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_API_BASE=https://api.groq.com/openai/v1
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
VITE_API_URL=http://localhost:8000
