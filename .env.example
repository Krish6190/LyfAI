# At least two keys, comma-separated. Never commit real keys.
LLM_API_KEYS=key-one-placeholder,key-two-placeholder
# Examples: groq/llama-3.1-8b-instant, openrouter/google/gemini-2.0-flash-exp:free
LLM_MODEL=groq/llama-3.1-8b-instant
# Set this for providers that expose an OpenAI-compatible endpoint.
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_API_BASE=https://api.groq.com/openai/v1
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
VITE_API_URL=http://localhost:8000

